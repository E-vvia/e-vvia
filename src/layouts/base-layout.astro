---
interface Props {
	title: string;
	mainClass?: string;
}

import { Font } from "astro:assets";
import "../styles/global.css";
import HeaderAstroComponent from "../components/header.astro";
const { title, mainClass } = Astro.props;
const pageTitle = "E-vvia - " + title;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<Font cssVariable="--font-fot-yuruka-std" preload />
		<script is:inline src="/scripts/theme.js"></script>
		<script is:inline src="/scripts/theme-switcher.js"></script>
		<meta name="og:title" content={pageTitle} />
		<meta name="og:description" content="E-vvia website!" />
		<meta property="og:url" content="https://www.e-vvia.moe" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="E-vvia" />
		<meta property="og:image" content="https://www.e-vvia.moe/images/shuuya_kano.webp">
		<meta property="og:locale" content="en_US" />

		<title>{pageTitle}</title>
	</head>

	<body class="min-h-lvh flex flex-col">
		<HeaderAstroComponent />
		<main class={mainClass}>
			<slot />
		</main>
	</body>
</html>
