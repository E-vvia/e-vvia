---
import KageProMenuLinks from "../../../data/archive/kagepro/menu-links.json";
import ArchiveLayout from "../../../layouts/archive-layout.astro";
import Image from "astro/components/Image.astro";
import KagePro from '../../../assets/images/archive/kagepro/kagepro.png';
import Link from "../../../components/link.astro";
---

<ArchiveLayout title="Kagerou Project Archive" sideMenuLinks={KageProMenuLinks}>
    <h1 id="Kagerou_Project" slot="header">Kagerou Project</h1>
    <div slot="content">
        <figure class="my-5 flex flex-col items-center">
            <Image
                alt="Kage pro characters"
                src={KagePro}
                priority
            />
            <figcaption
                class="mt-3 text-center text-sm text-gray-500 dark:text-gray-400"
            >
                <Link href="https://www.pixiv.net/artworks/35990245" target="_blank">Arb by Sidu</Link>
            </figcaption>
        </figure>
    </div>
</ArchiveLayout>
